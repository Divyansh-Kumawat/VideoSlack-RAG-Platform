# Copy to backend/.env and fill in your keys.

# ── LLM (required) ────────────────────────────────────────────────────────────
# Free key: https://console.mistral.ai
MISTRAL_API_KEY=
# Must be a model your Mistral plan allows. On the free tier, mistral-small /
# mistral-medium may be limited to 0 requests/min; ministral-14b-latest works.
MISTRAL_MODEL=ministral-14b-latest

# ── YouTube (optional) ────────────────────────────────────────────────────────
# YouTube Data API v3 key: https://console.cloud.google.com
# If empty, metadata is read with yt-dlp instead.
YOUTUBE_API_KEY=

# ── Embeddings ────────────────────────────────────────────────────────────────
# BAAI/bge-small-en-v1.5 | BAAI/bge-base-en-v1.5 | BAAI/bge-large-en-v1.5
# Changing this requires clearing the vector store (DELETE /videos) and re-ingesting.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Storage (relative paths resolve against backend/) ─────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=videoiq_chunks
DATA_DIR=./data

# ── RAG ───────────────────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVER_TOP_K=6
MEMORY_MAX_TURNS=10
LLM_TEMPERATURE=0.3
LLM_MAX_RETRIES=2

# ── Whisper fallback (for videos with no captions; needs ffmpeg) ─────────────
WHISPER_ENABLED=true
WHISPER_MODEL=small
WHISPER_TEMP_DIR=./tmp_audio

# ── Server ────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
